# 复制为 .env.production，所有 replace-* 必须换成真实值。
# 该文件同时供 Docker Compose 和后端容器读取。
PUBLIC_DOMAIN=voice.example.com
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8010
DEBUG=false
ENABLE_DOCS=false

MYSQL_ROOT_PASSWORD=replace-root-password-with-random-hex
MYSQL_APP_PASSWORD=replace-app-password-with-random-hex
DATABASE_URL=mysql+pymysql://livetrans:replace-app-password-with-random-hex@db:3306/livetrans_voice?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

JWT_SECRET=replace-jwt-secret-with-at-least-32-random-characters
ACCESS_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=30
CORS_ORIGINS=https://voice.example.com

# 中国大陆 CVM 建议使用国内可访问的翻译服务。
TRANSLATION_PROVIDER_ORDER=baidu
BAIDU_TRANSLATE_APP_ID=replace-baidu-translate-app-id
BAIDU_TRANSLATE_SECRET_KEY=replace-baidu-translate-secret-key
TRANSLATION_TIMEOUT_SECONDS=5
TRANSLATION_CACHE_TTL_SECONDS=3600

# 实时 ASR：baidu（默认）或 aliyun（百炼 Fun-ASR）。
# 选 aliyun 时填 DASHSCOPE_API_KEY；分片降级仍可用下面的百度短语音配置。
ASR_PROVIDER=baidu
DASHSCOPE_API_KEY=
ASR_ALIYUN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_ALIYUN_MODEL=fun-asr-realtime

# 百度短语音识别示例；也可换成项目支持的通用 multipart ASR 服务。
ASR_API_URL=https://vop.baidu.com/server_api
ASR_API_KEY=replace-baidu-asr-api-key
ASR_API_SECRET=replace-baidu-asr-secret-key
ASR_APP_ID=replace-baidu-asr-app-id
ASR_REALTIME_URL=wss://vop.baidu.com/realtime_asr
ASR_REALTIME_PREVIEW_INTERVAL_MS=800
ASR_CONTEXT_SENTENCES=3
ASR_MODEL=
ASR_TIMEOUT_SECONDS=20
ASR_MAX_SEGMENT_MB=10

MAX_AVATAR_SIZE_MB=2
MAX_AUDIO_SIZE_MB=100
MAX_VIDEO_SIZE_MB=1024
# Docker 内默认路径；Windows 本地开发会自动探测已安装工具。
FFMPEG_BINARY=/usr/bin/ffmpeg
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
OCR_LANGUAGES=chi_sim+eng

# 课堂简报。生产环境建议配置国内可访问的 OpenAI 兼容接口；留空则抽取式生成。
BRIEFING_LLM_API_URL=
BRIEFING_LLM_API_KEY=
BRIEFING_LLM_MODEL=deepseek-chat
BRIEFING_LLM_TIMEOUT_SECONDS=45
BRIEFING_MAX_SENTENCES=400
BRIEFING_STALE_SECONDS=120
