# 本地开发配置。生产环境请通过密钥管理服务注入，不要提交真实值。
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8010
DEBUG=false
ENABLE_DOCS=true

DATABASE_URL=mysql+pymysql://root:root123@127.0.0.1:13306/livetrans_voice?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=30
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

TRANSLATION_PROVIDER_ORDER=google,mymemory
ENTERPRISE_TRANSLATION_API_URL=
ENTERPRISE_TRANSLATION_API_KEY=
GOOGLE_TRANSLATE_API_URL=https://translate.googleapis.com/translate_a/single
MYMEMORY_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_TIMEOUT_SECONDS=3
TRANSLATION_CACHE_TTL_SECONDS=3600
ASR_PROVIDER=baidu
DASHSCOPE_API_KEY=
ASR_ALIYUN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_ALIYUN_MODEL=fun-asr-realtime
ASR_API_URL=
ASR_API_KEY=
ASR_APP_ID=
ASR_API_SECRET=
ASR_REALTIME_URL=wss://vop.baidu.com/realtime_asr
ASR_REALTIME_PREVIEW_INTERVAL_MS=800
ASR_CONTEXT_SENTENCES=3
# 单条字幕上限 / interim 只译尾部 / 超时强制断句（毫秒）
# 课堂场景默认略放宽，并合并过短 final，减少「话说一半被切开」。
ASR_MAX_SEGMENT_CHARS=200
ASR_PREVIEW_TRANSLATE_CHARS=80
ASR_FORCE_FINAL_MS=25000
ASR_HISTORY_DOM_LIMIT=80
ASR_MERGE_MIN_CHARS=40
ASR_MERGE_WAIT_MS=1800
ASR_ALIYUN_SEMANTIC_PUNCTUATION=true
ASR_ALIYUN_MAX_SENTENCE_SILENCE_MS=1800
ASR_ALIYUN_HEARTBEAT=true
ASR_MODEL=
ASR_TIMEOUT_SECONDS=20
ASR_MAX_SEGMENT_MB=10
MAX_AVATAR_SIZE_MB=2
MAX_AUDIO_SIZE_MB=100

# 课堂简报：留空则用抽取式生成（不依赖大模型）。
# 若要提升摘要质量，可填 OpenAI 兼容接口，例如 DeepSeek / 通义 / OpenAI。
BRIEFING_LLM_API_URL=
BRIEFING_LLM_API_KEY=
BRIEFING_LLM_MODEL=deepseek-chat
BRIEFING_LLM_TIMEOUT_SECONDS=45
# 滚动窗口 LLM Token 默认额度（简报+助手）
LLM_QUOTA_WINDOW_DAYS=30
LLM_QUOTA_FREE_TOKENS=200000
LLM_QUOTA_PREMIUM_TOKENS=2000000
BRIEFING_MAX_SENTENCES=400
BRIEFING_STALE_SECONDS=120
