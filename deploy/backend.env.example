# 复制到 /etc/livetrans/backend.env，并设置权限 chmod 600。
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8010
DEBUG=false
ENABLE_DOCS=false

DATABASE_URL=mysql+pymysql://livetrans:replace-me@127.0.0.1:3306/livetrans_voice?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=30
CORS_ORIGINS=https://app.example.com

ASR_API_URL=https://speech.example.com/v1/audio/transcriptions
ASR_API_KEY=replace-me
ASR_MODEL=replace-me
ASR_TIMEOUT_SECONDS=20
ASR_MAX_SEGMENT_MB=10

TRANSLATION_PROVIDER_ORDER=enterprise
ENTERPRISE_TRANSLATION_API_URL=https://translate.example.com/v1/translate
ENTERPRISE_TRANSLATION_API_KEY=replace-me
TRANSLATION_TIMEOUT_SECONDS=3
TRANSLATION_CACHE_TTL_SECONDS=3600
MAX_AVATAR_SIZE_MB=2
MAX_AUDIO_SIZE_MB=100
