[Unit]
Description=LiveTrans Voice FastAPI
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=livetrans
Group=livetrans
WorkingDirectory=/opt/livetrans/003.UI/backend
EnvironmentFile=/etc/livetrans/backend.env
ExecStart=/opt/livetrans/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/livetrans/003.UI/frontend/uploads
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
